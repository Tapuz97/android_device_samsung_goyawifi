+                mDevice->free(mDevice, original);
+                break;
+            }
+            {
+                std::lock_guard<std::mutex> lock(mMutex);
+                mOwners.emplace(handles[allocated], original);
+            }
+            *stride = static_cast<uint32_t>(localStride);
+        }
+        if (status != NO_ERROR) {
