+// Stock T110 gralloc keeps GPU signals in the allocation owner, not in the
+// transported file descriptors. A binderized allocator frees those signals
+// before import. Same-process registerBuffer is a no-op in this driver, so
+// merely switching IAllocator to passthrough would leave dangling surfaces.
+// Retain the original allocation alongside the mapper's registered clone.
+class T110LegacyAllocation {
+public:
+    static T110LegacyAllocation& get() {
+        static auto* state = new T110LegacyAllocation;
+        return *state;
+    }
+
+    bool enabled() const { return mEnabled; }
+    bool ready() const { return mDevice != nullptr; }
+
+    status_t allocate(const Gralloc2Mapper& mapper, uint32_t width, uint32_t height,
+                      PixelFormat format, uint32_t layerCount, uint64_t usage,
+                      uint32_t count, uint32_t* stride, buffer_handle_t* handles,
+                      bool importBuffers) {
+        if (!mDevice) return NO_INIT;
+        // Raw FD-only ownership cannot preserve this legacy driver's signals.
+        if (!importBuffers || layerCount != 1 || usage >> 32 || !count ||
+            width > INT_MAX || height > INT_MAX) return BAD_VALUE;
+        // HW_FB returns an unshareable framebuffer handle (FD -1). HWC's
+        // client target must instead be a normal GPU buffer it can import.
+        // Stock bit 31 selects linear ION backing even with HW_RENDER. The
+        // direct fbdev presenter must CPU-read the finished client target.
+        uint32_t flags = static_cast<uint32_t>(usage & ~uint64_t(GRALLOC_USAGE_HW_FB));
+        if (usage & GRALLOC_USAGE_HW_FB) flags |= 0x80000000u | GRALLOC_USAGE_SW_READ_OFTEN;
+        const int legacyUsage = static_cast<int>(flags);
+        status_t status = NO_ERROR;
+        uint32_t allocated = 0;
+        for (; allocated < count; ++allocated) {
+            buffer_handle_t original = nullptr;
+            int localStride = 0;
+            {
+                std::lock_guard<std::mutex> lock(mMutex);
+                status = mDevice->alloc(mDevice, width, height, format, legacyUsage,
+                                        &original, &localStride);
+            }
+            if (status != NO_ERROR) break;
+            if (allocated && *stride != static_cast<uint32_t>(localStride)) {
+                std::lock_guard<std::mutex> lock(mMutex);
+                mDevice->free(mDevice, original);
+                status = BAD_VALUE;
+                break;
+            }
+            status = mapper.importBuffer(hardware::hidl_handle(original), &handles[allocated]);
+            if (status != NO_ERROR) {
+                std::lock_guard<std::mutex> lock(mMutex);
+                mDevice->free(mDevice, original);
+                break;
+            }
+            {
+                std::lock_guard<std::mutex> lock(mMutex);
+                mOwners.emplace(handles[allocated], original);
+            }
+            *stride = static_cast<uint32_t>(localStride);
+        }
+        if (status != NO_ERROR) {
+            while (allocated) {
+                --allocated;
+                mapper.freeBuffer(handles[allocated]);
+                handles[allocated] = nullptr;
+            }
+        }
+        return status;
+    }
+
+    void releaseOwner(buffer_handle_t imported) {
+        std::lock_guard<std::mutex> lock(mMutex);
+        const auto it = mOwners.find(imported);
+        if (it == mOwners.end()) return; // buffer imported from another process
+        const int error = mDevice->free(mDevice, it->second);
+        ALOGE_IF(error, "T110 legacy allocation release failed: %d", error);
+        mOwners.erase(it);
+    }
+
+private:
+    T110LegacyAllocation() : mEnabled(base::GetBoolProperty("ro.t110.legacy_gpu", false)) {
+        if (!mEnabled) return;
+        // libui also has an APEX variant. Keep this device-only legacy
+        // backend optional instead of imposing libhardware on every APEX.
+        void* library = dlopen("libhardware.so", RTLD_NOW | RTLD_LOCAL);
+        auto getModule = library ? reinterpret_cast<int (*)(const char*, const hw_module_t**)>(
+                dlsym(library, "hw_get_module")) : nullptr;
+        if (!getModule) {
+            ALOGE("T110 legacy gralloc loader unavailable");
+            return;
+        }
+        // Keep the library loaded for the process-long alloc_device_t.
+        const hw_module_t* module = nullptr;
+        int error = getModule(GRALLOC_HARDWARE_MODULE_ID, &module);
+        if (!error) error = gralloc_open(module, &mDevice);
+        if (error) {
+            mDevice = nullptr;
+            ALOGE("T110 legacy gralloc open failed: %d", error);
+        } else {
+            ALOGI("T110 legacy gralloc: retaining allocation owners in process");
+        }
+    }
+    const bool mEnabled;
+    alloc_device_t* mDevice = nullptr;
+    std::mutex mMutex;
+    std::unordered_map<buffer_handle_t, buffer_handle_t> mOwners;
+};
