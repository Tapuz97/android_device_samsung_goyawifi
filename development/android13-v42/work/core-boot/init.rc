import /init.environ.rc

on early-init
    start ueventd

on init
    mount tmpfs tmpfs /data nosuid nodev mode=0771,size=128m
    restorecon /data
    mkdir /data/misc 01771 system misc
    mkdir /data/local 0751 root root
    mkdir /data/local/tmp 0771 shell shell
    mkdir /dev/socket 0755 root root
    mkdir /linkerconfig/bootstrap 0755
    mkdir /linkerconfig/default 0755
    exec -- /system/bin/bootstrap/linkerconfig --target /linkerconfig/bootstrap
    chmod 0644 /linkerconfig/bootstrap/ld.config.txt
    copy /linkerconfig/bootstrap/ld.config.txt /linkerconfig/default/ld.config.txt
    mount none /linkerconfig/bootstrap /linkerconfig bind rec
    exec_start apexd-bootstrap
    umount /linkerconfig
    update_linker_config

on late-init
    start logd
    start servicemanager
    start hwservicemanager

on property:ro.boot.t110_usb=1
    mkdir /dev/usb-ffs 0775 shell shell
    mkdir /dev/usb-ffs/adb 0770 shell shell
    mount functionfs adb /dev/usb-ffs/adb uid=2000,gid=2000
    write /sys/class/android_usb/android0/enable 0
    write /sys/class/android_usb/android0/idVendor 18D1
    write /sys/class/android_usb/android0/idProduct D001
    write /sys/class/android_usb/android0/iManufacturer Samsung
    write /sys/class/android_usb/android0/iProduct T110-Android13-Core
    write /sys/class/android_usb/android0/iSerial ${ro.serialno}
    write /sys/class/android_usb/android0/f_ffs/aliases adb
    write /sys/class/android_usb/android0/functions adb
    start adbd

on property:sys.usb.ffs.ready=1
    write /sys/class/android_usb/android0/enable 1
    setprop sys.usb.state adb

service ueventd /system/bin/ueventd
    stdio_to_kmsg
    seclabel u:r:ueventd:s0

service apexd-bootstrap /system/bin/apexd --bootstrap
    user root
    group system
    disabled
    oneshot
    stdio_to_kmsg

service logd /system/bin/logd
    socket logd stream 0666 logd logd
    socket logdr seqpacket 0666 logd logd
    socket logdw dgram+passcred 0222 logd logd
    file /proc/kmsg r
    file /dev/kmsg w
    user root
    group logd system package_info readproc
    priority 10
    stdio_to_kmsg

service servicemanager /system/bin/servicemanager
    user system
    group system readproc
    stdio_to_kmsg

service hwservicemanager /system/bin/hwservicemanager
    user system
    group system readproc
    onrestart setprop hwservicemanager.ready false
    stdio_to_kmsg

service adbd /apex/com.android.adbd/bin/adbd --root_seclabel=u:r:su:s0
    disabled
    stdio_to_kmsg
    socket adbd stream 0660 system system
    seclabel u:r:adbd:s0

service surfaceflinger /system/bin/surfaceflinger
    disabled
    oneshot
    user system
    group graphics drmrpc readproc
    stdio_to_kmsg
