// Proprietary libraries from the verified SM-T110 stock firmware.

// Loaded by libGLESv2_MRVL through dlopen when compiling GLSL shaders.
cc_prebuilt_library_shared {
    name: "t110_libGLESv2SC",
    stem: "libGLESv2SC",
    srcs: ["libGLESv2SC.so"],
    vendor: true,
    compile_multilib: "32",
    strip: { none: true },
    check_elf_files: false,
    shared_libs: [],
}

