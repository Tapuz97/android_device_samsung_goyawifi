diff --git a/prebuilts/api/33.0/private/property_contexts b/prebuilts/api/33.0/private/property_contexts
index b3bb039017fd946117e113d49ec4ef278bc3c25e..e0a8080934dcc0b4b8339ebe5b824c5be5c3359c 100644
--- a/prebuilts/api/33.0/private/property_contexts
+++ b/prebuilts/api/33.0/private/property_contexts
@@ -1370,3 +1370,17 @@ virtualizationservice.state.last_cid u:object_r:virtualizationservice_prop:s0 ex
 
 # Adaptive haptics settings property
 vibrator.adaptive_haptics.enabled u:object_r:adaptive_haptics_prop:s0 exact string
+
+# T110 engineering compatibility switches must be readable by native services.
+ro.t110.legacy_processgroups u:object_r:exported_default_prop:s0 exact bool
+ro.t110.legacy_usb u:object_r:exported_default_prop:s0 exact bool
+ro.t110.legacy_gpu u:object_r:exported_default_prop:s0 exact bool
+ro.t110.legacy_bpf u:object_r:exported_default_prop:s0 exact bool
+
+ro.t110.legacy_audio u:object_r:exported_default_prop:s0 exact bool
+
+persist.audio.apmaster u:object_r:audio_config_prop:s0 exact bool
+
+persist.audio.gsspmaster u:object_r:audio_config_prop:s0 exact bool
+
+persist.audio.codecmaster u:object_r:audio_config_prop:s0 exact bool
diff --git a/prebuilts/api/33.0/public/attributes b/prebuilts/api/33.0/public/attributes
index 1719935f9fb2028f8eb4eccb257c125f92d4853c..f3896a9fc01d90d35789d9b0de612b78bde81c15 100644
--- a/prebuilts/api/33.0/public/attributes
+++ b/prebuilts/api/33.0/public/attributes
@@ -1,3 +1,8 @@
+attribute t110_audio_file_type;
+# T110 stock GPU library. Only the device policy assigns this attribute.
+attribute t110_gpu_file_type;
+
+
 ######################################
 # Attribute declarations
 #
diff --git a/prebuilts/api/33.0/public/domain.te b/prebuilts/api/33.0/public/domain.te
index 7bed5e7eff1468f55623f4016324badc2e008e1a..b532649c6ef1c1ee967630352917e860985f1659 100644
--- a/prebuilts/api/33.0/public/domain.te
+++ b/prebuilts/api/33.0/public/domain.te
@@ -1082,6 +1082,8 @@ neverallow * {
   -apk_data_file
   -app_data_file
   -asec_public_file
+  -t110_gpu_file_type
+  -t110_audio_file_type
 }:file execmod;
 
 # Do not allow making the stack or heap executable.
@@ -1091,7 +1093,7 @@ neverallow * self:process { execstack execheap };
 
 # Do not allow the introduction of new execmod rules. Text relocations
 # and modification of executable pages are unsafe.
-neverallow { domain -untrusted_app_25 -untrusted_app_27 } file_type:file execmod;
+neverallow { domain -untrusted_app_25 -untrusted_app_27 } { file_type -t110_gpu_file_type -t110_audio_file_type }:file execmod;
 
 neverallow { domain -init } proc:{ file dir } mounton;
 
@@ -1351,3 +1353,6 @@ neverallow { domain -traced_probes -init -vendor_init } debugfs_tracing_printk_f
 
 # Linux lockdown "integrity" level is enforced for user builds.
 neverallow { domain userdebug_or_eng(`-domain') } self:lockdown integrity;
+
+# Only the audio service may relocate the exact old DSP file.
+neverallow { domain -hal_audio_server } t110_audio_file_type:file execmod;
