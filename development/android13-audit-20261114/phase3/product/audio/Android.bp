// SPDX-License-Identifier: Apache-2.0
// Integrate this directory at device/samsung/t110_bringup/audio.
cc_library_shared {
    name: "audio.primary.t110",
    vendor: true,
    relative_install_path: "hw",
    compile_multilib: "32",
    srcs: ["AudioAdapter.cpp", "AudioModule.cpp"],
    header_libs: ["libhardware_headers"],
    shared_libs: ["libdl"],
    cflags: ["-Wall", "-Wextra", "-Werror"],
}

cc_library_shared {
    name: "libt110_audio_legacy_compat",
    vendor: true,
    compile_multilib: "32",
    srcs: ["LegacyList.cpp"],
    cflags: ["-Wall", "-Wextra", "-Werror"],
}


cc_prebuilt_library_shared {
    name: "t110_ani7_audio_primary_mrvl",
    stem: "audio.primary.mrvl",
    vendor: true,
    compile_multilib: "32",
    srcs: [
        "vendor/lib/hw/audio.primary.mrvl.so"
    ],
    strip: {
        none: true
    },
    shared_libs: [
        "libt110_audio_legacy_compat",
        "liblog",
        "libcutils",
        "t110_ani7_libasound",
        "libhardware",
        "libaudioutils",
        "libeffects",
        "t110_ani7_libacoustic",
        "t110_ani7_libaudiodebugtool",
        "t110_ani7_libsamsungSoundbooster",
        "t110_ani7_libsamsungRecord",
        "libc",
        "t110_libstdcpp",
        "libm"
    ],
    check_elf_files: true,
    relative_install_path: "hw"
}

