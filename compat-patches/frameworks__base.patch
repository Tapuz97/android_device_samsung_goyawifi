+    gT110PowerModuleCompat.init = t110LegacyPowerInit;
+    gT110PowerModuleCompat.setInteractive = t110LegacySetInteractive;
+    if (module->common.module_api_version >= POWER_MODULE_API_VERSION_0_2 &&
+            module->powerHint) {
+        gT110PowerModuleCompat.powerHint = t110LegacyPowerHint;
+    }
+    return &gT110PowerModuleCompat;
+}
