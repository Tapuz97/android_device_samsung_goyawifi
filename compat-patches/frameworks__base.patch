+static power_module_t* adaptT110LegacyPowerModule(power_module_t* module) {
+    if (!module || module->common.module_api_version > POWER_MODULE_API_VERSION_0_2)
+        return module;
+    gT110LegacyPowerModule = module;
+    gT110PowerModuleCompat = {};
+    // Common metadata keeps the real API version; this does not claim new features.
