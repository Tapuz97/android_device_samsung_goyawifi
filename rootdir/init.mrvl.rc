# The verified system loop is mounted before second-stage init.
# Without mount_all, import its native services explicitly; init_user0 needs vold.
import /system/etc/init

# The stage mounts a distinct Nougat data directory; never mount physical SYSTEM.
on init
    # Nougat ueventd places this graphics-subsystem node below /dev/graphics.
    symlink /dev/graphics/galcore /dev/galcore
    mkdir /dev/usb-ffs 0770 shell shell
    mkdir /dev/usb-ffs/adb 0770 shell shell
    mount functionfs adb /dev/usb-ffs/adb uid=2000,gid=2000
    write /sys/class/android_usb/android0/enable 0
    write /sys/class/android_usb/android0/idVendor 18d1
    write /sys/class/android_usb/android0/idProduct 4ee7
    write /sys/class/android_usb/android0/iManufacturer Samsung
    write /sys/class/android_usb/android0/iProduct SM-T110
    write /sys/class/android_usb/android0/iSerial ${ro.serialno}
    write /sys/class/android_usb/android0/f_ffs/aliases adb
    write /sys/class/android_usb/android0/functions adb
    write /sys/class/android_usb/android0/enable 1
    start adbd
    setprop sys.usb.config adb
    setprop sys.usb.configfs 0
    # Retain the actual display timing permissions from the Android13 port.
    chown system graphics /sys/devices/platform/pxa168-fb.0/vsync
    chmod 0660 /sys/devices/platform/pxa168-fb.0/vsync
    restorecon /sys/devices/platform/pxa168-fb.0/vsync
    chown system system /sys/class/backlight/panel/brightness
    chmod 0660 /sys/class/backlight/panel/brightness
on fs
    setprop ro.crypto.state unencrypted
on post-fs-data
    swapon_all /fstab.t110.zram
    mkdir /data/misc/wifi 0770 wifi wifi
    mkdir /data/misc/bluedroid 02770 bluetooth bluetooth
    mkdir /data/vendor 0755 root root
    mkdir /data/vendor/t110-bluetooth 0770 root bluetooth
    write /proc/sys/vm/swappiness 100
    write /proc/sys/vm/page-cluster 0
    start t110-radio-init
    trigger nonencrypted
on property:sys.usb.ffs.ready=1
    write /sys/class/android_usb/android0/enable 1
    setprop sys.usb.state adb
on property:sys.boot_completed=1
    write /dev/t110-keepalive 1
service t110-radio-init /system/bin/t110_radio_init
    class core
    user root
    group root wifi inet net_admin
    disabled
    oneshot
service t110-bt-init /system/bin/t110_bt_init
    class core
    user root
    group root bluetooth net_admin
    disabled
    oneshot
on property:init.svc.t110-radio-init=stopped
    start t110-bt-init
service wpa_supplicant /system/bin/wpa_supplicant -iwlan0 -Dnl80211 -c/data/misc/wifi/wpa_supplicant.conf -O/data/misc/wifi/sockets -g@android:wpa_wlan0
    class main
    socket wpa_wlan0 dgram 0660 wifi wifi
    disabled
    oneshot

# Stock ANI7 selects AP-master audio clocks before the audio HAL starts.
# Nougat runs the HAL in audioserver, which is a member of the audio group.
on post-fs-data
    chown system audio /proc/driver/ssp_master
    chmod 0660 /proc/driver/ssp_master
    chown system audio /proc/driver/gssp_master
    chmod 0660 /proc/driver/gssp_master
    setprop persist.audio.apmaster 1
    setprop persist.audio.gsspmaster 1
    setprop persist.audio.codecmaster 0
